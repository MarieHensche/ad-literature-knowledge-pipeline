    "include_criteria": [
      "Papers directly studying Alzheimer's disease using computational methods",
      "Papers that examine methodologies, tools, and approaches in computational biology related to Alzheimer's",
      "Reviews, meta-analyses, and empirical studies that help map the topic."
    ],
    "exclude_criteria": [
      "Papers focusing on unrelated neurological disorders that do not pertain to Alzheimer's disease."
    ],
    "boundary_rules": [
      "Include borderline or tangentially relevant papers when they address one meaningful aspect of computational biology methods in Alzheimer's research.",
      "Exclude papers only when the title and abstract clearly indicate a lack of relevance to Alzheimer's disease or computational biology."
    ]
