  "research_topic": {
    "title": "Artificial Intelligence in Alzheimer's Disease Research",
    "description": "Applications of artificial intelligence to understanding, detecting, diagnosing, predicting, monitoring, and treating Alzheimer's disease. The collection is restricted to papers published from January 1, 2020 through June 19, 2026."
  },
  "scope": {
    "include_criteria": [
      "Papers directly studying the application of AI in Alzheimer's disease research",
      "Papers investigating related technologies, methodologies, and frameworks that apply to AI and Alzheimer's",
      "Review articles that summarize and synthesize existing research in this area",
      "Empirical studies that provide evidence of AI effectiveness in Alzheimer's diagnosis or treatment",
      "Papers published from January 1, 2020 through June 19, 2026"
    ],
    "exclude_criteria": [
      "Papers lacking a substantive connection to AI in Alzheimer's disease",
      "Papers focused only on other neurological diseases without an explicit Alzheimer's disease analysis",
      "Papers published before 2020 or after June 19, 2026"
    ],
    "boundary_rules": [
      "Include borderline papers that discuss AI technologies relevant to the field of Alzheimer's",
      "Exclude papers whose titles and abstracts clearly indicate they are unrelated"
    ]
  },
