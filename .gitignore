# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
.venv
venv/
venv
env/

# Secrets
.env
.env.*
!.env.example

# IDE/editor
.vscode/
.idea/
.Rhistory

# Data / full text not committed
data/full_text/
data/pdfs/
inputs/pdfs/
inputs/full_text/
*.pdf

# Large/archive formats
*.zip
*.pages
*.numbers

# Generated outputs
outputs/
reports/generated/
data/processed/example_*
# Immutable provider response pages and indexes are generated, potentially large,
# and may contain third-party metadata. Tests use fixtures outside these paths.
data/raw/*_provider_response_pages/
data/raw/*_provider_evidence_index.jsonl
# Canonical corpus snapshots are generated from provider metadata and stay local.
data/processed/*_corpus_records.jsonl
data/processed/*_corpus_snapshot_integrity.json
# Local P2.0 live-stabilization artifacts are retained as audit evidence but
# must not be mixed with source changes.
data/collection_plans/p20_stabilization_*
data/raw/p20_stabilization_*
data/processed/p20_stabilization_*
runs/
# Logs and temp
*.log
tmp/
temp/
